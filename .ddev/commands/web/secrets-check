#!/usr/bin/env bash

## Description: Report which credential source is in use and what is missing

# Mirrors the resolution order in org-env and composer-auth so a developer can
# see which source actually won — not just whether the destination exists. A
# provided file is authoritative and never refreshes, so knowing the source
# matters when keys rotate.

set -u

APPROOT="${DDEV_APPROOT:-/var/www/html}"
missing=0

ok() { printf '  \033[32m✓\033[0m %-22s %s\n' "$1" "$2"; }
bad() { printf '  \033[31m✗\033[0m %-22s %s\n' "$1" "$2"; }

printf '\nCredentials\n'

# --- Shared org config layer -------------------------------------------------
if [ -f "$APPROOT/.conf/org.env" ]; then
  ok "org config layer" "project override — .conf/org.env"
elif [ -f "${HOME}/.sitchco/org.env" ]; then
  ok "org config layer" "machine drop — ~/.ddev/homeadditions/.sitchco/org.env"
elif [ -f /var/www/.env ]; then
  ok "org config layer" "sitdev/workflow-support clone"
else
  bad "org config layer" "missing — no org license keys or policy flags"
  missing=1
fi

if [ ! -f /var/www/.env ]; then
  bad "  installed at" "/var/www/.env is absent — run 'ddev org-env'"
  missing=1
fi

# --- Composer credentials ----------------------------------------------------
if [ -f "$APPROOT/.conf/auth.json" ]; then
  ok "composer auth" "project override — .conf/auth.json"
elif [ -f "${HOME}/.composer/auth.json" ]; then
  ok "composer auth" "machine drop or satis clone — ~/.composer/auth.json"
else
  bad "composer auth" "missing — 'composer install' will fail on private packages"
  missing=1
fi

if [ "$missing" -eq 0 ]; then
  printf '\n'
  exit 0
fi

cat <<EOM

Obtain the missing files through secure delivery, then place them at either

  ~/.ddev/homeadditions/.sitchco/org.env      all projects on this machine
  ~/.ddev/homeadditions/.composer/auth.json   all projects on this machine

or, to scope them to this project only,

  .conf/org.env
  .conf/auth.json

Then run 'ddev org-env' and 'ddev composer-auth'. Situation developers can
instead run 'ddev auth ssh' and re-run those commands to fetch from the org.

EOM
exit 0
