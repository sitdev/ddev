#!/usr/bin/env bash

## Description: Initialize a local WP database using standard defaults.
## Usage: local-init [flags]
## Example: "ddev local-init" or "ddev local-init -i"
## Flags: [{"Shorthand":"i","Usage":"Expanded dialog to set password, set up options, activate plugins, etc."}]

is_multisite() {
  grep -q 'WP_ALLOW_MULTISITE.*true' wp-config.php
}

# Shared migration helpers (append_multisite_constants — grep-guarded so
# re-runs never duplicate local-config.php constants).
source "$(dirname "${BASH_SOURCE[0]}")/.migration-utilities"

while getopts "i" option; do
  case "${option}" in

  i)
    INITIAL_RUN=1
    ;;
  esac
done

USER_PASS=test
if [ -n "${INITIAL_RUN}" ]; then
  read -p "sit-admin password: [test] " USER_PASS
  USER_PASS=${USER_PASS:-test}
fi
composer update situation/scripts situation/backstage -o >/dev/null 2>&1
echo "Installing WP Core..."
if is_multisite; then
  wp core multisite-install --skip-config --url=${DDEV_PRIMARY_URL} --title="${SITE_TITLE}" --admin_user="sit-admin" --admin_email="developers@situationinteractive.com" >/dev/null 2>&1
  append_multisite_constants
  cat >.htaccess <<-EOM
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteRule ^([_0-9a-zA-Z-]+/)?wp-admin$ \$1wp-admin/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^([_0-9a-zA-Z-]+/)?(wp-(content|admin|includes).*) wp/\$2 [L]
RewriteRule ^([_0-9a-zA-Z-]+/)?(.*\.php)$ wp/\$2 [L]
RewriteRule . index.php [L]
EOM
  wp rewrite structure '/%postname%/' --url=${DDEV_PRIMARY_URL}
  wp rewrite flush --url=${DDEV_PRIMARY_URL}
else
  wp core install --url=${DDEV_PRIMARY_URL} --title="${SITE_TITLE}" --admin_user="sit-admin" --admin_email="developers@situationinteractive.com" >/dev/null 2>&1
  wp rewrite structure '/%postname%/' --url=${DDEV_PRIMARY_URL}
  wp rewrite flush --hard --url=${DDEV_PRIMARY_URL}
fi
wp user update sit-admin --user_pass=${USER_PASS}
echo "Set default password: ${USER_PASS}"
if [ -n "${INITIAL_RUN}" ]; then
  wp option update timezone_string "America/New_York"
  wp option delete blogdescription comments_notify default_comment_status default_ping_status default_pingback_flag comment_moderation moderation_notify comment_registration show_avatars close_comments_for_old_posts page_comments
  wp post delete 1 --force
  wp post update 2 --post_content="" --post_title="Home" --post_name="home"
  wp option update show_on_front "page"
  wp option update page_on_front 2
fi
if is_multisite; then
  wp plugin activate backstage advanced-custom-fields-pro wp-migrate-db-pro --url=${DDEV_PRIMARY_URL} --network
else
  wp plugin activate backstage advanced-custom-fields-pro wp-migrate-db-pro --url=${DDEV_PRIMARY_URL}
fi

if [ -n "${INITIAL_RUN}" ]; then
  echo "Getting plugin list..."
  # "slug — Title" rows, built with jq rather than a CSV split so titles
  # containing commas survive. The slug leads, so the first " — " always
  # separates it from the title.
  options=()
  mapfile -t options < <(
    wp plugin list --fields=name,title --format=json --status=inactive --url=${DDEV_PRIMARY_URL} |
      jq -r '.[] | "\(.name) — \(.title)"'
  )

  if [ ${#options[@]} -eq 0 ]; then
    echo "No inactive plugins to activate."
  elif ! has_gum; then
    # gum replaced dialog as the container's TUI toolkit. If it is missing,
    # skip this optional step rather than failing a local-init that has
    # otherwise already succeeded.
    echo "gum not found — skipping optional plugin activation." >&2
  else
    # SPACE does NOT toggle in gum v2: Bubble Tea v2 reports that key as
    # "space", but gum's binding still lists " ", so only X and TAB match
    # (gum's own footer says "x toggle"). ENTER on a merely highlighted row
    # submits nothing, as does ESC — both mean "activate none", so the
    # header names only the keys that actually work.
    choices=$(gum choose --no-limit --height=15 \
      --header "Activate plugins (X or TAB toggles, ENTER confirms, ESC skips)" \
      "${options[@]}") || true
    if [ -n "${choices}" ]; then
      wp plugin activate $(sed -e 's/ — .*$//' <<<"${choices}" | tr '\n' ' ') --url=${DDEV_PRIMARY_URL}
    fi
  fi
  echo "Login at ${DDEV_PRIMARY_URL}/wp/wp-admin/ with sit-admin / ${USER_PASS}"
fi
