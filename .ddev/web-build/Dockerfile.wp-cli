# Install WP-CLI when the base image doesn't ship it.
#
# Since DDEV v1.25.5 the web image only includes WP-CLI for the wordpress and
# wp-bedrock project types, so `ddev wp` fails with "wp: command not found" in
# our type: php projects. Older DDEV versions bake it into every image at the
# same path, so this is a no-op there.
# https://docs.ddev.com/en/stable/users/extend/customizing-images/#project-specific-utilities
RUN if ! command -v wp >/dev/null 2>&1; then \
        curl --fail -sSL -o /usr/local/bin/wp-cli \
            https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar && \
        chmod +x /usr/local/bin/wp-cli && \
        ln -sf /usr/local/bin/wp-cli /usr/local/bin/wp; \
    fi
